{
  "name": "powerchat",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p logs && vite dev --host 0.0.0.0 --port 9009 2>&1 | tee logs/dev.log",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 9009",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "sync:streams": "bun run scripts/generate-sync-streams.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@mastra/core": "^1.13.2",
    "@mastra/mcp": "^1.2.1",
    "@powersync/common": "^1.50.0",
    "@powersync/drizzle-driver": "^0.7.3",
    "@powersync/node": "^0.16.0",
    "@powersync/web": "^1.37.0",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "2.0.0-alpha.2",
    "@types/pg": "^8.15.6",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "solid-js": "^1.9.9",
    "solid-marked": "^0.6.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@solidjs/vite-plugin-nitro-2": "^0.1.0",
    "@tailwindcss/vite": "^4.0.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bun": "^1.3.11",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "glob": "10.5.0",
    "jsdom": "^25.0.1",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^4.0.7",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
