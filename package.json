    "@powersync/web": "^1.37.0",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "^1.1.0",
    "@types/pg": "^8.15.6",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "solid-js": "^1.9.5",
    "solid-marked": "^0.6.3",
